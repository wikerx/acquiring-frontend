VITE_ADMIN_API_BASE_URL=
VITE_ADMIN_DEV_PROXY_TARGET=http://127.0.0.1:8001

# Comma-separated exact HTTPS origins allowed in external iframes, including ports when needed.
# Examples: https://monitor.example.com,https://monitor.example.com:8443
VITE_ADMIN_EXTERNAL_FRAME_ALLOWED_ORIGINS=

# Deprecated compatibility option. Each hostname maps only to its default HTTPS origin on port 443.
VITE_ADMIN_EXTERNAL_FRAME_ALLOWED_HOSTS=

# Local development only. These values are read only when Vite runs in dev mode.
# Do not configure these keys in production build or deployment environments.
VITE_ADMIN_DEV_LOGIN_ASSIST=true
VITE_ADMIN_DEV_LOGIN_ACCOUNT=admin
VITE_ADMIN_DEV_LOGIN_PASSWORD=Admin@123456
