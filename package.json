{
  "name": "acquiring-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "dompurify": "3.4.17",
    "follow-redirects": "1.16.2",
    "minimatch": "11.0.3",
    "vue": "3.5.44"
  },
  "scripts": {
    "dev:admin": "npm --workspace @acquiring/admin-system run dev",
    "dev:merchant": "npm --workspace @acquiring/merchant-portal run dev",
    "dev:checkout": "npm --workspace @acquiring/hosted-checkout run dev",
    "dev:hosted-checkout": "npm --workspace @acquiring/hosted-checkout run dev",
    "dev:cashier": "npm run dev:checkout",
    "build": "npm run build --workspaces --if-present",
    "build:admin": "npm --workspace @acquiring/admin-system run build",
    "build:merchant": "npm --workspace @acquiring/merchant-portal run build",
    "build:checkout": "npm --workspace @acquiring/hosted-checkout run build",
    "build:hosted-checkout": "npm --workspace @acquiring/hosted-checkout run build",
    "build:cashier": "npm run build:checkout",
    "test:amount": "npm --workspace @acquiring/shared run test:amount",
    "test:submission-guard": "npm --workspace @acquiring/shared run test:submission-guard",
    "test:channel-presentation": "node --test packages/shared/tests/channelPresentation.test.mjs",
    "test:source-time-zone": "node --test packages/shared/tests/sourceTimeZone.test.mjs",
    "test:e2e:channel": "playwright test --config=playwright.channel.config.ts",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.ts",
    "test:e2e:login": "playwright test --config=playwright.login.config.ts",
    "test:e2e:payment-link": "playwright test --config=playwright.payment-link.config.ts",
    "test:e2e:merchant": "playwright test e2e/merchant-transaction-notification.spec.ts",
    "test:governance:file-templates": "node scripts/verify-file-template-governance.mjs",
    "test:governance:submissions": "node scripts/verify-submission-governance.mjs",
    "test:governance:exports": "node scripts/verify-export-governance.mjs",
    "test:governance:transaction-status": "node scripts/verify-transaction-stage-status-governance.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages --max-warnings=0",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,vue,css,md,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.14.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.3"
  }
}
